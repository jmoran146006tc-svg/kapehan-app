rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function myRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return myRole() == 'admin';
    }

    function currentViewCount(data) {
      return ('viewCount' in data) ? data.viewCount : 0;
    }

    function validShop(data) {
      return data.keys().hasOnly([
          'name', 'ownerId', 'address', 'lat', 'lng', 'priceMin', 'priceMax',
          'hasWifi', 'tags', 'description', 'photos', 'hours', 'status', 'avgRating', 'reviewCount',
          'ratingCounts', 'viewCount'
        ]) &&
        data.keys().hasAll([
          'name', 'ownerId', 'address', 'lat', 'lng', 'priceMin', 'priceMax',
          'hasWifi', 'tags', 'photos', 'hours', 'status', 'avgRating', 'reviewCount'
        ]) &&
        data.name is string && data.ownerId is string && data.address is string &&
        data.lat is number && data.lng is number &&
        data.priceMin is number && data.priceMin >= 0 &&
        data.priceMax is number && data.priceMax >= data.priceMin &&
        data.hasWifi is bool &&
        data.tags is list && data.tags.size() <= 6 &&
        data.tags.hasOnly(['Quiet', 'Study-Friendly', 'Airconditioned', 'Open 24/7', 'Nature', 'Cozy', 'Pet-Friendly', 'Outdoor Seating', 'Free Parking', 'Vegan Options', 'Live Music', 'Power Outlets', 'Group-Friendly']) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        data.photos is list && data.hours is map &&
        data.status in ['pending', 'approved', 'rejected'] &&
        data.avgRating is number && data.avgRating >= 0 && data.avgRating <= 5 &&
        data.reviewCount is int && data.reviewCount >= 0 &&
        (!('ratingCounts' in data) || validRatingCounts(data.ratingCounts)) &&
        (!('viewCount' in data) || (data.viewCount is int && data.viewCount >= 0));
    }

    function validRatingCounts(counts) {
      return counts is map &&
        counts.keys().hasOnly(['1', '2', '3', '4', '5']) &&
        counts.keys().hasAll(['1', '2', '3', '4', '5']) &&
        counts['1'] is int && counts['1'] >= 0 &&
        counts['2'] is int && counts['2'] >= 0 &&
        counts['3'] is int && counts['3'] >= 0 &&
        counts['4'] is int && counts['4'] >= 0 &&
        counts['5'] is int && counts['5'] >= 0;
    }

    function validReviewFields() {
      return request.resource.data.keys().hasOnly(['userId', 'userName', 'rating', 'text', 'createdAt', 'ownerReply']) &&
        request.resource.data.keys().hasAll(['userId', 'userName', 'rating', 'text', 'createdAt']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userName is string &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.text is string && request.resource.data.text.size() <= 1000 &&
        request.resource.data.createdAt == request.time &&
        (!('ownerReply' in request.resource.data) ||
          (request.resource.data.ownerReply is map &&
            request.resource.data.ownerReply.keys().hasOnly(['text', 'repliedAt']) &&
            request.resource.data.ownerReply.keys().hasAll(['text', 'repliedAt']) &&
            request.resource.data.ownerReply.text is string &&
            request.resource.data.ownerReply.text.size() <= 500 &&
            request.resource.data.ownerReply.repliedAt is timestamp));
    }

    function aggregateMatchesReview(shopId) {
      let shopBefore = get(/databases/$(database)/documents/shops/$(shopId));
      let shopAfter = getAfter(/databases/$(database)/documents/shops/$(shopId));
      let reviewBeforePath = /databases/$(database)/documents/shops/$(shopId)/reviews/$(request.auth.uid);
      let reviewAfter = getAfter(/databases/$(database)/documents/shops/$(shopId)/reviews/$(request.auth.uid));
      let reviewAlreadyExists = exists(reviewBeforePath);
      let oldRating = reviewAlreadyExists ? get(reviewBeforePath).data.rating : 0;
      let nextCount = shopBefore.data.reviewCount + (reviewAlreadyExists ? 0 : 1);
      let nextAverage = ((shopBefore.data.avgRating * shopBefore.data.reviewCount) - oldRating + reviewAfter.data.rating) / nextCount;

      return ((('ratingCounts' in shopBefore.data) &&
          shopAfter.data.diff(shopBefore.data).affectedKeys().hasOnly(['avgRating', 'reviewCount', 'ratingCounts']) &&
          validRatingCounts(shopAfter.data.ratingCounts) &&
          shopAfter.data.ratingCounts['1'] == shopBefore.data.ratingCounts['1'] +
            (reviewAfter.data.rating == 1 ? 1 : 0) - (reviewAlreadyExists && oldRating == 1 ? 1 : 0) &&
          shopAfter.data.ratingCounts['2'] == shopBefore.data.ratingCounts['2'] +
            (reviewAfter.data.rating == 2 ? 1 : 0) - (reviewAlreadyExists && oldRating == 2 ? 1 : 0) &&
          shopAfter.data.ratingCounts['3'] == shopBefore.data.ratingCounts['3'] +
            (reviewAfter.data.rating == 3 ? 1 : 0) - (reviewAlreadyExists && oldRating == 3 ? 1 : 0) &&
          shopAfter.data.ratingCounts['4'] == shopBefore.data.ratingCounts['4'] +
            (reviewAfter.data.rating == 4 ? 1 : 0) - (reviewAlreadyExists && oldRating == 4 ? 1 : 0) &&
          shopAfter.data.ratingCounts['5'] == shopBefore.data.ratingCounts['5'] +
            (reviewAfter.data.rating == 5 ? 1 : 0) - (reviewAlreadyExists && oldRating == 5 ? 1 : 0)) ||
        (!('ratingCounts' in shopBefore.data) &&
          shopAfter.data.diff(shopBefore.data).affectedKeys().hasOnly(['avgRating', 'reviewCount']))) &&
        reviewAfter.data.userId == request.auth.uid &&
        reviewAfter.data.rating is int &&
        reviewAfter.data.rating >= 1 && reviewAfter.data.rating <= 5 &&
        reviewAfter.data.createdAt == request.time &&
        shopAfter.data.reviewCount == nextCount &&
        shopAfter.data.avgRating == nextAverage;
    }

    function validNotification() {
      return request.resource.data.keys().hasOnly(['type', 'message', 'shopId', 'read', 'createdAt']) &&
        request.resource.data.keys().hasAll(['type', 'message', 'shopId', 'read', 'createdAt']) &&
        request.resource.data.type in ['listing_approved', 'listing_rejected', 'review_received', 'review_reply', 'shop_hours_updated', 'shop_menu_updated'] &&
        request.resource.data.message is string && request.resource.data.message.size() <= 1000 &&
        request.resource.data.shopId is string && request.resource.data.read == false &&
        request.resource.data.createdAt == request.time;
    }

    function isAdminStatusNotification(uid) {
      let shopBefore = get(/databases/$(database)/documents/shops/$(request.resource.data.shopId));
      let shopAfter = getAfter(/databases/$(database)/documents/shops/$(request.resource.data.shopId));
      return isAdmin() && shopBefore.data.ownerId == uid && shopAfter.data.ownerId == uid &&
        ((shopBefore.data.status == 'pending' &&
          ((request.resource.data.type == 'listing_approved' && shopAfter.data.status == 'approved') ||
            (request.resource.data.type == 'listing_rejected' && shopAfter.data.status == 'rejected'))) ||
          (shopBefore.data.status == 'approved' && request.resource.data.type == 'listing_rejected' &&
            shopAfter.data.status == 'rejected') ||
          (shopBefore.data.status == 'rejected' && request.resource.data.type == 'listing_approved' &&
            shopAfter.data.status == 'approved'));
    }

    function isReviewNotification(uid) {
      let shop = get(/databases/$(database)/documents/shops/$(request.resource.data.shopId));
      let reviewAfter = getAfter(/databases/$(database)/documents/shops/$(request.resource.data.shopId)/reviews/$(request.auth.uid));
      return isSignedIn() && request.auth.uid != uid &&
        request.resource.data.type == 'review_received' && shop.data.ownerId == uid &&
        reviewAfter.data.userId == request.auth.uid && reviewAfter.data.createdAt == request.time;
    }

    function isReviewReplyNotification(uid) {
      let shop = get(/databases/$(database)/documents/shops/$(request.resource.data.shopId));
      let reviewBefore = get(/databases/$(database)/documents/shops/$(request.resource.data.shopId)/reviews/$(uid));
      let reviewAfter = getAfter(/databases/$(database)/documents/shops/$(request.resource.data.shopId)/reviews/$(uid));
      return isSignedIn() && request.auth.uid != uid &&
        request.resource.data.type == 'review_reply' && shop.data.ownerId == request.auth.uid &&
        reviewBefore.data.userId == uid && !('ownerReply' in reviewBefore.data) &&
        reviewAfter.data.ownerReply.text is string &&
        reviewAfter.data.ownerReply.repliedAt == request.time;
    }

    function isFavoriteShopUpdateNotification(uid) {
      let shop = get(/databases/$(database)/documents/shops/$(request.resource.data.shopId));
      let recipient = get(/databases/$(database)/documents/users/$(uid));
      return isSignedIn() &&
        request.resource.data.type in ['shop_hours_updated', 'shop_menu_updated'] &&
        shop.data.ownerId == request.auth.uid &&
        recipient.data.savedShopIds is list &&
        recipient.data.savedShopIds.hasAny([request.resource.data.shopId]);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Admin accounts are intentionally provisioned outside this client app.
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['name', 'email', 'role', 'status', 'createdAt', 'preferences', 'savedShopIds', 'recentlyViewed', 'visitCount']) &&
        request.resource.data.keys().hasAll(['name', 'email', 'role', 'status', 'createdAt', 'preferences', 'savedShopIds', 'recentlyViewed']) &&
        request.resource.data.name is string && request.resource.data.email == request.auth.token.email &&
        request.resource.data.role in ['user', 'owner'] &&
        request.resource.data.status == 'active' && request.resource.data.createdAt == request.time &&
        request.resource.data.preferences is map && request.resource.data.savedShopIds is list &&
        request.resource.data.recentlyViewed is list &&
        (!('visitCount' in request.resource.data) || (request.resource.data.visitCount is int && request.resource.data.visitCount >= 0));
      // Admin accounts are provisioned with privileged credentials, not by changing a client profile.
      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'preferences', 'savedShopIds', 'recentlyViewed', 'visitCount', 'reviewCount']);
      // The profile owner cannot silently unsuspend their own account.
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['active', 'suspended'];

      // Signed-in clients use a random, short-lived document to verify a deployed
      // Firestore connection. It is intentionally restricted to a timestamp-only
      // create, server read, and cleanup by the profile owner.
      match /connectivity/{checkId} {
        allow create: if isOwner(uid) &&
          request.resource.data.keys().hasOnly(['checkedAt']) &&
          request.resource.data.keys().hasAll(['checkedAt']) &&
          request.resource.data.checkedAt == request.time;
        allow get, delete: if isOwner(uid);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        // Notification creators must be the matching admin decision or review transaction.
        allow create: if validNotification() && (isAdminStatusNotification(uid) || isReviewNotification(uid) || isReviewReplyNotification(uid) || isFavoriteShopUpdateNotification(uid));
        allow update: if isOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
          request.resource.data.read is bool;
      }
    }

    match /shops/{shopId} {
      match /followers/{uid} {
        allow read: if isOwner(uid) || isOwner(get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId);
        allow create: if isOwner(uid) &&
          request.resource.data.keys().hasOnly(['createdAt']) &&
          request.resource.data.createdAt == request.time &&
          getAfter(/databases/$(database)/documents/users/$(uid)).data.savedShopIds.hasAny([shopId]);
        allow delete: if isOwner(uid) &&
          !getAfter(/databases/$(database)/documents/users/$(uid)).data.savedShopIds.hasAny([shopId]);
      }
      allow read: if resource.data.status == 'approved' || isOwner(resource.data.ownerId) || isAdmin();
      allow create: if myRole() == 'owner' && validShop(request.resource.data) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.status == 'pending' && request.resource.data.avgRating == 0 &&
        request.resource.data.reviewCount == 0 &&
        (!('ratingCounts' in request.resource.data) ||
          (request.resource.data.ratingCounts['1'] == 0 && request.resource.data.ratingCounts['2'] == 0 &&
           request.resource.data.ratingCounts['3'] == 0 && request.resource.data.ratingCounts['4'] == 0 &&
           request.resource.data.ratingCounts['5'] == 0)) &&
        (!('viewCount' in request.resource.data) || request.resource.data.viewCount == 0);
      allow update: if (isAdmin() && validShop(request.resource.data) &&
          ((resource.data.status == 'pending' && request.resource.data.status in ['approved', 'rejected']) ||
            (resource.data.status == 'approved' && request.resource.data.status == 'rejected') ||
            (resource.data.status == 'rejected' && request.resource.data.status == 'approved')) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
        (isOwner(resource.data.ownerId) && validShop(request.resource.data) &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.avgRating == resource.data.avgRating &&
          request.resource.data.reviewCount == resource.data.reviewCount &&
          request.resource.data.status == 'pending' &&
          resource.data.status in ['pending', 'approved', 'rejected'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'address', 'lat', 'lng', 'priceMin', 'priceMax', 'hasWifi', 'tags', 'description', 'photos', 'hours', 'status'
          ])) ||
        (isSignedIn() && resource.data.status == 'approved' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']) &&
          request.resource.data.viewCount is int &&
          request.resource.data.viewCount == currentViewCount(resource.data) + 1) ||
        (isSignedIn() && aggregateMatchesReview(shopId));

      match /products/{productId} {
        function validProduct(data) {
          return data.keys().hasOnly(['name', 'description', 'price', 'category', 'photoUrl', 'available', 'createdAt']) &&
            data.keys().hasAll(['name', 'price', 'category', 'available', 'createdAt']) &&
            data.name is string && data.name.size() <= 80 &&
            (!('description' in data) || (data.description is string && data.description.size() <= 300)) &&
            data.price is number && data.price >= 0 &&
            data.category in ['Espresso', 'Latte', 'Non-Coffee', 'Pastries & Food', 'Other'] &&
            (!('photoUrl' in data) || data.photoUrl is string) &&
            data.available is bool && data.createdAt == request.time;
        }

        allow read: if get(/databases/$(database)/documents/shops/$(shopId)).data.status == 'approved' ||
          isOwner(get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId) || isAdmin();
        allow create, update: if isSignedIn() &&
          get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid &&
          validProduct(request.resource.data);
        allow delete: if isSignedIn() &&
          get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
      }

      match /reviews/{reviewId} {
        allow read: if true;
        // The review UID is the author UID and the parent aggregate must change in this same transaction.
        allow create: if isOwner(reviewId) && validReviewFields() && aggregateMatchesReview(shopId);
        allow update: if isOwner(reviewId) && validReviewFields() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'text', 'createdAt']) &&
          aggregateMatchesReview(shopId);
        allow update: if isSignedIn() &&
          get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerReply']) &&
          request.resource.data.ownerReply is map &&
          request.resource.data.ownerReply.keys().hasOnly(['text', 'repliedAt']) &&
          request.resource.data.ownerReply.keys().hasAll(['text', 'repliedAt']) &&
          request.resource.data.ownerReply.text is string && request.resource.data.ownerReply.text.size() <= 500 &&
          request.resource.data.ownerReply.repliedAt == request.time;
        // Deletion is intentionally unavailable until it also recalculates the parent summary atomically.
        allow delete: if false;
      }
    }
  }
}
